# Copy to .env and adjust. .env is gitignored; this file is not.
#
# Load into your shell before running anything that touches the database:
#     set -a && source .env && set +a
#
# `set -a` marks every variable assigned from here on for export, so the
# assignments in .env become part of the environment child processes inherit.
# `set +a` turns that back off.

PGHOST=localhost
PGPORT=5433
PGDATABASE=telemetry
PGUSER=telemetry
PGPASSWORD=devpassword
